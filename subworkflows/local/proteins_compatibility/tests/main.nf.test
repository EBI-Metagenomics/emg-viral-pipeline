nextflow_process {

    name "Test protein compatibility and rename"
    script "../main.nf"
    process "PROTEINS_COMPATIBILITY"

    tag "subworkflows"
    tag "proteins_compatibility"

    test("Proteins compatibility") {
        when {
            process {
                """
                input[0] = channel.of (
                    [
                        [ id:'matched' ],
                        file('${projectDir}/subworkflows/local/proteins_compatibility/tests/data/matched.fna', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/proteins_compatibility/tests/data/matched.gff', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/proteins_compatibility/tests/data/matched.faa', checkIfExists: true),
                    ],
                    [
                        [ id:'not_matched' ],
                        file('${projectDir}/subworkflows/local/proteins_compatibility/tests/data/not_matched.fna', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/proteins_compatibility/tests/data/not_matched.gff', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/proteins_compatibility/tests/data/not_matched.faa', checkIfExists: true),
                    ],
                    [
                        [ id:'require_rename' ],
                        file('${projectDir}/subworkflows/local/proteins_compatibility/tests/data/require_rename.fna', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/proteins_compatibility/tests/data/require_rename.gff', checkIfExists: true),
                        file('${projectDir}/subworkflows/local/proteins_compatibility/tests/data/require_rename.faa', checkIfExists: true),
                    ]
                )
                """
            }
        }
        then {
            assert process.success

            assertAll(
                { assert snapshot(
                    process.out
                ).match() },
            )
        }
    }
}

